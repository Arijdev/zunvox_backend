# Server Configuration
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Gotenberg Service Configuration
GOTENBERG_URL=http://localhost:3000
GOTENBERG_TIMEOUT_MS=60000

# File Upload Constraints (in bytes)
# 50MB maximum for document uploads
MAX_DOCUMENT_SIZE_BYTES=52428800
# 20MB maximum for image uploads
MAX_IMAGE_SIZE_BYTES=20971520

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Storage
UPLOAD_TEMP_DIR=./uploads/tmp

